{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^m-(.*)": "@/components/m-$1/m-$1.vue",
			"^external-(.*)": "@/components/external-$1/external-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/demo/index",
			"style": {
				"navigationBarTitleText": "组件 Demo",
				"navigationBarBackgroundColor": "#5192FF",
				"navigationBarTextStyle": "white",
				"enablePullDownRefresh": false
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uniapp-template",
		"navigationBarBackgroundColor": "#F5F7FB",
		"backgroundColor": "#F5F7FB"
	}
}
