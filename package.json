{
  "name": "uniapp-template",
  "version": "1.0.0",
  "description": "通用 uniapp 初始化模板（H5 / 微信小程序 / 钉钉小程序，Vue3 + 设计令牌）",
  "private": true,
  "scripts": {
    "verify": "node scripts/verify-convention.cjs && node scripts/verify-components.cjs && node scripts/verify-theme.cjs && node scripts/verify-date.cjs && node scripts/verify-demo.cjs",
    "verify:convention": "node scripts/verify-convention.cjs",
    "verify:components": "node scripts/verify-components.cjs",
    "verify:theme": "node scripts/verify-theme.cjs",
    "verify:date": "node scripts/verify-date.cjs",
    "verify:demo": "node scripts/verify-demo.cjs",
    "sync:theme": "node scripts/sync-theme.mjs",
    "lint": "eslint . --ext .js,.vue",
    "format": "prettier --write \"**/*.{js,vue,scss,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.26.0",
    "husky": "^9.1.0",
    "prettier": "^3.3.0",
    "sass": "^1.77.0"
  },
  "dependencies": {
    "pinia": "^2.2.0"
  }
}
